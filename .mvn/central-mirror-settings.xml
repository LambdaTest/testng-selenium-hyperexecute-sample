<?xml version="1.0" encoding="UTF-8"?>
<!-- Maven Central rate-limits HyperExecute VMs (HTTP 429), so fetch Central artifacts through
     Google's Central mirror. Loaded as global settings by .mvn/maven.config, so a user-level
     ~/.m2/settings.xml is still read. -->
<settings>
  <mirrors>
    <mirror>
      <id>central</id>
      <mirrorOf>central</mirrorOf>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
    </mirror>
  </mirrors>
</settings>
